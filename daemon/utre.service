# systemd user unit for utre-daemon (plan/08, plan/15 slice 3).
# Packages install it to /usr/lib/systemd/user/; scripts/install-user-service.sh installs a
# dev copy pointing at this checkout's build. Enable with:
#   systemctl --user enable --now utre.service
[Unit]
Description=Utre daemon (task database, tray, reminders)
Documentation=https://github.com/Belkata/utre
# The tray and notifications need the graphical session's D-Bus and Wayland environment.
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/utre-daemon
# What the tray's Open starts.
Environment=UTRE_APP=/usr/bin/utre-app
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target

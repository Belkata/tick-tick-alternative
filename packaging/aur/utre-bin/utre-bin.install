post_install() {
  echo ">> Start the Utre daemon (tray, reminders, sync) with:"
  echo "     systemctl --user daemon-reload && systemctl --user enable --now utre.service"
}

post_upgrade() {
  echo ">> The running daemon and app are still the old version until you restart them:"
  echo "     systemctl --user daemon-reload && systemctl --user restart utre.service"
  echo "   then close and reopen the Utre app."
}

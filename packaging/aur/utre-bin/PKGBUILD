# Maintainer: Boris Belev <belkata.okfo@gmail.com>
# utre-bin: the prebuilt Linux release of Utre (app, tray daemon and `utre` CLI).
#
# This file is a TEMPLATE. scripts/aur-publish.sh fills in pkgver and the real sha256 in a copy and
# pushes that copy to the AUR; the version here is never bumped. The tarball comes from
# scripts/build-linux-tarball.sh and is attached to the GitHub release vX.Y.Z.
# After installing: systemctl --user daemon-reload && systemctl --user enable --now utre.service
pkgname=utre-bin
pkgver=0.8.10
pkgrel=1
pkgdesc="Local-first task manager: Flutter desktop app, tray daemon and utre CLI (prebuilt)"
arch=(x86_64)
url="https://github.com/Belkata/utre"
license=(MIT)
depends=(gtk3 glibc gcc-libs hicolor-icon-theme)
optdepends=(
  'waybar: tray icon (any StatusNotifierItem host works)'
  'dunst: reminder notifications with Done and Snooze (any notification daemon works)'
)
provides=(utre)
conflicts=(utre utre-git tick-alt-git)
# The Flutter AOT snapshot (libapp.so) must not be stripped.
options=(!strip !debug)
install=utre-bin.install
source=("$pkgname-$pkgver.tar.gz::https://github.com/Belkata/utre/releases/download/v${pkgver}/utre-${pkgver}-linux-x86_64.tar.gz")
# 'SKIP' in the template; aur-publish.sh writes the real checksum.
sha256sums=('SKIP')

package() {
  cd "utre-$pkgver"
  install -Dm755 bin/utre "$pkgdir/usr/bin/utre"
  install -Dm755 bin/utre-daemon "$pkgdir/usr/bin/utre-daemon"

  # The Flutter bundle stays together (it finds lib/ and data/ next to its binary).
  install -d "$pkgdir/usr/lib/utre"
  cp -r lib/utre/. "$pkgdir/usr/lib/utre/"
  ln -s /usr/lib/utre/utre "$pkgdir/usr/bin/utre-app"

  install -Dm644 share/systemd/utre.service "$pkgdir/usr/lib/systemd/user/utre.service"
  install -Dm644 share/dev.utre.utre.desktop \
    "$pkgdir/usr/share/applications/dev.utre.utre.desktop"
  install -Dm644 share/dev.utre.utre.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/dev.utre.utre.svg"
  install -Dm644 licenses/Manrope-OFL.txt "$pkgdir/usr/share/licenses/$pkgname/Manrope-OFL.txt"
  if [[ -f LICENSE ]]; then
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  fi
}
